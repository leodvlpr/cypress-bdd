# Test configuration template. Copy to `.env` (git-ignored) and adjust it for your target:
#   cp .env.example .env
# A non-empty environment variable with the same name overrides the value in .env (useful in CI).
# Required keys must be set; optional keys are marked as such. Values below target automationexercise.com.

# --- Target application -------------------------------------------------------------------------
BASE_URL=https://automationexercise.com
# Attribute holding the test ids agreed with development (e.g. data-qa, data-testid, data-cy).
TEST_ID_ATTRIBUTE=data-qa
# Optional. Comma-separated third-party hosts to block (consent dialogs, ads overlaying the app).
BLOCK_HOSTS=fundingchoicesmessages.google.com,*.googlesyndication.com,*.doubleclick.net,*.adtrafficquality.google

# --- Test users (a unique user is generated per scenario) ---------------------------------------
# Generated emails look like <prefix>.<unique id>@<domain>. Use a domain you control or example.com.
TEST_USER_EMAIL_PREFIX=qa.user
TEST_USER_EMAIL_DOMAIN=example.com
# Optional. Fixed password for generated users; leave empty for a random password per scenario.
# Test-only: it is never logged, but it is visible in `cypress open` (Settings > resolved configuration).
TEST_USER_PASSWORD=
# Profile used for sign-up and checked at checkout. TEST_USER_TITLE: Mr | Mrs.
TEST_USER_TITLE=Mr
TEST_USER_FIRST_NAME=QA
TEST_USER_LAST_NAME=User
TEST_USER_BIRTH_DAY=1
TEST_USER_BIRTH_MONTH=1
TEST_USER_BIRTH_YEAR=1990
TEST_USER_COMPANY=Test Co
TEST_USER_ADDRESS1=1 Test Street
TEST_USER_ADDRESS2=Apt 1
# Must be one of the countries the sign-up form offers.
TEST_USER_COUNTRY=Canada
TEST_USER_STATE=Test State
TEST_USER_CITY=Test City
TEST_USER_ZIPCODE=00000
TEST_USER_MOBILE=0000000000

# --- Contact form -------------------------------------------------------------------------------
# Contact emails look like <prefix>.<unique id>@<domain>.
CONTACT_NAME=QA Visitor
CONTACT_EMAIL_PREFIX=qa.contact
CONTACT_EMAIL_DOMAIN=example.com

# --- Payment (test card only, never a real one) ------------------------------------------------
PAYMENT_CARD_NUMBER=4111111111111111
PAYMENT_CARD_CVC=123
PAYMENT_CARD_EXPIRY_MONTH=12
# Optional. Defaults to the current year + 5.
PAYMENT_CARD_EXPIRY_YEAR=

# --- Reference data -----------------------------------------------------------------------------
# JSON array of products the scenarios refer to by name (path relative to the project root).
CATALOG_FIXTURE=cypress/fixtures/products.json
